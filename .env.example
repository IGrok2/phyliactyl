# ============================================================
#  Phyliactyl — конфигурация (скопируйте в .env.local или .env)
# ============================================================

# --- Брендирование ---
# Название панели по умолчанию (если не переопределено в Panel Settings
# и не получено из настроек Pterodactyl). По умолчанию: Phyliactyl
APP_NAME=Phyliactyl
# Подзаголовок под названием (необязательно)
APP_TAGLINE=Game Servers
# То же имя для клиента (до загрузки /api/branding). Должно совпадать с APP_NAME.
NEXT_PUBLIC_APP_NAME=Phyliactyl

# --- Подключение к Pterodactyl ---
# Базовый URL вашей панели Pterodactyl (без завершающего слэша).
# Если задан — подставляется в форму входа. Можно оставить пустым:
# тогда пользователь вводит URL вручную на странице входа.
PTERODACTYL_URL=https://panel.example.com

# Client API ключ (ptlc_...). Account → API Credentials.
# Необязательный fallback для single-tenant режима (без логина).
# В многопользовательском режиме НЕ обязателен — ключ берётся из сессии.
PTERODACTYL_CLIENT_KEY=

# Application API ключ (ptla_...). Admin → Application API.
# Нужен для админ-разделов (ноды, локации, пользователи, нэсты).
# Можно не задавать здесь, а ввести в панели: Admin → Application API.
# ВАЖНО: у ключа должны быть права Read/Read&Write на нужные ресурсы.
PTERODACTYL_APP_KEY=

# --- Безопасность (рекомендуется для production) ---
# Длинная случайная строка. Зарезервировано для подписи сессии.
# SESSION_SECRET=change-me-to-a-long-random-string

# ВАЖНО:
# - Все ключи читаются ТОЛЬКО на сервере (BFF route handlers) и не
#   попадают в браузер (кроме NEXT_PUBLIC_*).
# - Для production обязательно используйте HTTPS (cookie-флаг secure
#   включается автоматически при NODE_ENV=production).
# - Глобальные настройки панели (брендирование/SMTP/HTTP) сохраняются в
#   .nebula-settings.json (этот файл в .gitignore — не коммитьте его).
